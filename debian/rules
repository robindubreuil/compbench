#!/usr/bin/make -f

export DH_VERBOSE = 1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Build with the full set of distro compiler/linker flags (hardening,
# -O2, LFS) instead of overriding them with a fixed string.
CFLAGS  := $(shell dpkg-buildflags --get CFLAGS) $(shell dpkg-buildflags --get CPPFLAGS)
LDFLAGS := $(shell dpkg-buildflags --get LDFLAGS)

%:
	dh $@

override_dh_auto_build:
	$(MAKE) CFLAGS="$(CFLAGS) -Wall -Wextra" LDFLAGS="$(LDFLAGS)"

override_dh_auto_install:
	$(MAKE) install DESTDIR=debian/compbench PREFIX=/usr

override_dh_usrlocal:
	# Prevent installing into /usr/local
